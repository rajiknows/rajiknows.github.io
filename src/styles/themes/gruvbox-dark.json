{
  "name": "gruvbox-dark-medium",
  "type": "dark",
  "colors": {
    "editor.background": "#282828",
    "editor.foreground": "#ebdbb2"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment", "string.comment"],
      "settings": { "foreground": "#928374", "fontStyle": "italic" }
    },
    {
      "scope": ["string", "string.quoted", "constant.other.symbol", "meta.string"],
      "settings": { "foreground": "#b8bb26" }
    },
    {
      "scope": ["constant.character.escape", "constant.other.placeholder"],
      "settings": { "foreground": "#fe8019" }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.character", "keyword.other.unit"],
      "settings": { "foreground": "#d3869b" }
    },
    {
      "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control", "keyword.operator.new"],
      "settings": { "foreground": "#fb4934" }
    },
    {
      "scope": ["keyword.operator", "punctuation", "meta.brace"],
      "settings": { "foreground": "#8ec07c" }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call.generic", "meta.function-call"],
      "settings": { "foreground": "#8ec07c" }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "entity.name.namespace", "support.type", "support.class", "storage.type.built-in"],
      "settings": { "foreground": "#fabd2f" }
    },
    {
      "scope": ["variable.parameter", "variable.other", "meta.definition.variable"],
      "settings": { "foreground": "#83a598" }
    },
    {
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#fb4934" }
    },
    {
      "scope": ["entity.other.attribute-name", "support.type.property-name"],
      "settings": { "foreground": "#fabd2f" }
    },
    {
      "scope": ["variable.language", "support.variable"],
      "settings": { "foreground": "#fe8019" }
    },
    {
      "scope": ["markup.heading", "entity.name.section"],
      "settings": { "foreground": "#b8bb26", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.bold"],
      "settings": { "fontStyle": "bold" }
    },
    {
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic" }
    }
  ]
}
