---
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import FormattedDate from "../components/FormattedDate.astro";

type Props = {
    post: CollectionEntry<"blog">;
};
const { post } = Astro.props;
const { title, description, pubDate, updatedDate } = post.data;
---

<html lang="en">
    <head>
        <BaseHead title={title} description={description} />
    </head>
    <body>
        <main>
            <a href="/blog" class="back">&larr; Posts</a>
            <article>
                <h1>{title}</h1>
                <div class="meta">
                    <FormattedDate date={pubDate} />
                    {
                        updatedDate && (
                            <span> · updated <FormattedDate date={updatedDate} /></span>
                        )
                    }
                </div>
                <div class="content">
                    <slot />
                </div>
            </article>
        </main>

        <style>
            body {
                font-family: Georgia, "Times New Roman", serif;
                color: #111;
                background: #fff;
                max-width: 40em;
                margin: 0 auto;
                padding: 4em 1.2em 6em 1.2em;
                line-height: 1.65;
                font-size: 21px;
            }
            .back {
                color: #555;
                text-decoration: none;
                font-size: 0.9em;
            }
            h1 {
                font-size: 1.7em;
                margin: 0.8em 0 0.2em 0;
                line-height: 1.3;
            }
            .meta {
                color: #777;
                font-size: 0.85em;
                margin-bottom: 2em;
            }
            .content :global(p) {
                margin: 0 0 1.3em 0;
            }
            .content :global(h2),
            .content :global(h3) {
                margin: 1.6em 0 0.6em 0;
                line-height: 1.3;
            }
            .content :global(a) {
                color: #111;
            }
            .content :global(ul),
            .content :global(ol) {
                margin: 0 0 1.3em 0;
                padding-left: 1.3em;
            }
            .content :global(blockquote) {
                margin: 1.3em 0;
                padding-left: 1em;
                border-left: 2px solid #ccc;
                color: #444;
            }
            .content :global(code) {
                font-family: Menlo, Consolas, monospace;
                font-size: 0.85em;
                background: #f2f2f2;
                padding: 0.1em 0.3em;
            }
            .content :global(pre) {
                background: #f2f2f2;
                padding: 1em;
                margin: 0 0 1.3em 0;
                max-width: 100%;
                white-space: pre-wrap;
                word-break: break-word;
            }
            .content :global(pre code) {
                background: none;
                padding: 0;
            }
            .content :global(img) {
                max-width: 100%;
            }
        </style>
    </body>
</html>
