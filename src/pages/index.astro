---
import BaseHead from "../components/BaseHead.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    </head>
    <body>
        <main>
            <h1>Rajesh Jha</h1>
            <p>
                Backend and systems programmer. I work on low-level tools,
                distributed systems and infrastructure — mostly in Rust and
                Go.
            </p>
            <nav>
                <a href="/blog">Posts</a>
                <a href="/notes">Notes</a>
                <a href="/contact">Contact me</a>
            </nav>
        </main>

        <style>
            h1 {
                font-size: 1.6em;
                margin: 0 0 0.5em 0;
            }
            p {
                margin: 0 0 1.5em 0;
            }
            nav {
                display: flex;
                gap: 1.5em;
            }
        </style>
    </body>
</html>
