---
import BaseHead from "../components/BaseHead.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { getCollection, render } from "astro:content";
import FormattedDate from "../components/FormattedDate.astro";
import ThemeToggle from "../components/ThemeToggle.astro";

const notes = (await getCollection("notes")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const rendered = await Promise.all(
    notes.map(async (note) => ({ note, Content: (await render(note)).Content })),
);
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead
            title={`Notes | ${SITE_TITLE}`}
            description={SITE_DESCRIPTION}
        />
    </head>
    <body>
        <ThemeToggle />
        <main>
            <a href="/" class="back">&larr; Rajesh Jha</a>
            <h1>Notes</h1>
            {
                rendered.map(({ note, Content }) => (
                    <section class="entry">
                        <div class="meta">
                            <FormattedDate date={note.data.pubDate} />
                            {note.data.title && <span> · {note.data.title}</span>}
                        </div>
                        <div class="content">
                            <Content />
                        </div>
                    </section>
                ))
            }
        </main>

        <style>
            h1 {
                font-size: 1.4em;
                margin: 1em 0 1em 0;
            }
            .entry {
                padding: 1.6em 0;
                border-bottom: 1px solid var(--border);
            }
            .entry:last-child {
                border-bottom: none;
            }
            .meta {
                color: var(--muted);
                font-size: 0.85em;
                margin-bottom: 0.6em;
            }
            .content :global(p) {
                margin: 0 0 1em 0;
            }
            .content :global(ul),
            .content :global(ol) {
                margin: 0 0 1em 0;
                padding-left: 1.3em;
            }
            .content :global(pre) {
                background: var(--code-background);
                padding: 1em;
                margin: 0 0 1em 0;
                max-width: 100%;
                white-space: pre-wrap;
                word-break: break-word;
            }
            .content :global(code) {
                font-family: "JetBrains Mono", Menlo, Consolas, monospace;
                font-size: 0.85em;
                background: var(--code-background);
                padding: 0.1em 0.3em;
            }
            .content :global(pre code) {
                background: none;
                padding: 0;
            }
            .content :global(img) {
                max-width: 100%;
            }
        </style>
    </body>
</html>
