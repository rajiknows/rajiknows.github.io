---
import BaseHead from "../components/BaseHead.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead
            title={`Contact | ${SITE_TITLE}`}
            description={SITE_DESCRIPTION}
        />
    </head>
    <body>
        <main>
            <a href="/" class="back">&larr; Rajesh Jha</a>
            <h1>Contact</h1>
            <ul>
                <li>
                    Twitter/X: <a href="https://x.com/Raj_ghj" target="_blank">@Raj_ghj</a>
                </li>
                <li>
                    GitHub: <a href="https://github.com/rajiknows" target="_blank">rajiknows</a>
                </li>
            </ul>
        </main>

        <style>
            body {
                font-family: Georgia, "Times New Roman", serif;
                color: #111;
                background: #fff;
                max-width: 46em;
                margin: 0 auto;
                padding: 4em 1.2em;
                line-height: 1.6;
                font-size: 20px;
            }
            .back {
                color: #555;
                text-decoration: none;
                font-size: 0.9em;
            }
            h1 {
                font-size: 1.4em;
                margin: 1em 0 1em 0;
            }
            ul {
                list-style: none;
                margin: 0;
                padding: 0;
            }
            li {
                padding: 0.4em 0;
            }
            a {
                color: #111;
                text-decoration: underline;
            }
        </style>
    </body>
</html>
